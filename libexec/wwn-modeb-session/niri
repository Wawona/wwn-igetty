#!/bin/sh
# Mode B TTY: niri is the session compositor on iland DRM/KMS/GBM.
# After Classic Take Over there is no host Wayland. Do not nest.
HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$HERE/env.sh"

wwn_modeb_real_niri() {
  for cand in \
    "${WWN_MODEB_NIRI-}" \
    "${WWN_MODEB_BIN-}/niri" \
    "$HERE/../../bin/niri" \
    "$HERE/../../../MacOS/niri" \
    "/Applications/Wawona.app/Contents/Resources/bin/niri" \
    "/Applications/Wawona.app/Contents/MacOS/niri"
  do
    case "$cand" in
      ""|*/wwn-modeb-session/niri) continue ;;
    esac
    if [ -x "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

real=$(wwn_modeb_real_niri) || {
  echo "modeb niri: bundled niri missing (set WWN_MODEB_NIRI)" >&2
  exit 127
}
exec "$real" "$@"
