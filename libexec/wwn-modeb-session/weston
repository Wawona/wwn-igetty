#!/bin/sh
# Mode B TTY: weston uses its DRM backend on iland KMS/GBM.
# After Classic Take Over there is no host Wayland. Do not nest.
HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$HERE/env.sh"

wwn_modeb_real_weston() {
  for cand in \
    "${WWN_MODEB_WESTON-}" \
    "${WWN_MODEB_BIN-}/weston" \
    "$HERE/../../bin/weston" \
    "$HERE/../../../MacOS/weston" \
    "/Applications/Wawona.app/Contents/Resources/bin/weston" \
    "/Applications/Wawona.app/Contents/MacOS/weston"
  do
    case "$cand" in
      ""|*/wwn-modeb-session/weston) continue ;;
    esac
    if [ -x "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

real=$(wwn_modeb_real_weston) || {
  echo "modeb weston: bundled weston missing (set WWN_MODEB_WESTON)" >&2
  exit 127
}

has_backend=0
prev=
for a in "$@"; do
  case "$a" in
    --backend=*|-B=*) has_backend=1 ;;
    --backend|-B) has_backend=1 ;;
  esac
  case "$prev" in
    --backend|-B) has_backend=1 ;;
  esac
  prev=$a
done
if [ "$has_backend" -eq 0 ]; then
  exec "$real" --backend=drm --continue-without-input "$@"
fi
exec "$real" "$@"
