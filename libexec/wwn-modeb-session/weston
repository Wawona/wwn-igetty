#!/bin/sh
# Mode B TTY: weston uses its DRM backend on iland KMS/GBM.
# After Classic Take Over there is no host Wayland. Do not nest.
unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY
export WWN_MODEB_TTY=1
if [ -n "${WWN_MODEB_INSERT-}" ]; then
  export DYLD_INSERT_LIBRARIES="$WWN_MODEB_INSERT"
fi
real="${WWN_MODEB_WESTON-}"
if [ -z "$real" ] && [ -n "${WWN_MODEB_BIN-}" ]; then
  real="$WWN_MODEB_BIN/weston"
fi
case "$real" in
  */wwn-modeb-session/weston)
    echo "modeb weston: WWN_MODEB_WESTON points at the session wrapper" >&2
    exit 127
    ;;
esac
if [ -z "$real" ] || [ ! -x "$real" ]; then
  echo "modeb weston: set WWN_MODEB_WESTON to the bundled weston" >&2
  exit 127
fi
has_backend=0
prev=
for a in "$@"; do
  case "$a" in
    --backend=*|-B=*)
      has_backend=1
      ;;
    --backend|-B)
      has_backend=1
      ;;
  esac
  case "$prev" in
    --backend|-B)
      has_backend=1
      ;;
  esac
  prev=$a
done
if [ "$has_backend" -eq 0 ]; then
  exec "$real" --backend=drm --continue-without-input "$@"
fi
exec "$real" "$@"
